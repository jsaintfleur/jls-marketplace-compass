# Marketplace Compass environment variables
#
# The live demo requires NO keys — it runs on the keyless UCI Online Retail II
# dataset (CC BY 4.0, direct download). The variable below is only needed to
# enable the proposed Olist-based models (late-delivery risk, Brazil geospatial
# expansion), whose ingestion is gated behind Kaggle authentication.

# Kaggle API credentials (for the proposed Olist Brazilian E-Commerce domain).
# Free: https://www.kaggle.com/settings -> "Create New Token" (downloads kaggle.json)
KAGGLE_USERNAME=
KAGGLE_KEY=
